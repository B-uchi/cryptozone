  "components": [
    {
      "name": "Solid Button",
      "kind": "button",
      "refersTo": "button-solid",
      "description": "The single primary action on a screen, printed in intaglio green.",
      "html": "<button class=\"ds-btn ds-btn-solid\">Browse the market</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:36px;padding:0 14px;border-radius:8px;font-family:Archivo,ui-sans-serif,system-ui,sans-serif;font-size:14px;font-weight:600;border:1px solid transparent;cursor:pointer;transition:background-color .15s,color .15s,border-color .15s,transform .15s}.ds-btn:active{transform:scale(.98)}.ds-btn:focus-visible{outline:2px solid rgb(var(--serial));outline-offset:2px}.ds-btn-solid{background:rgb(var(--note));color:rgb(var(--note-ink));box-shadow:0 1px 2px rgb(var(--shadow)/.10),0 8px 24px -10px rgb(var(--shadow)/.30)}.ds-btn-solid:hover{background:rgb(var(--note)/.9)}"
    },
    {
      "name": "Outline Button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Retry, pagination and load-more actions on paper.",
      "html": "<button class=\"ds-btn ds-btn-outline\">Try again</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:36px;padding:0 14px;border-radius:8px;font-family:Archivo,ui-sans-serif,system-ui,sans-serif;font-size:14px;font-weight:600;border:1px solid transparent;cursor:pointer;transition:background-color .15s,color .15s,border-color .15s,transform .15s}.ds-btn:active{transform:scale(.98)}.ds-btn:focus-visible{outline:2px solid rgb(var(--serial));outline-offset:2px}.ds-btn-outline{background:rgb(var(--panel));color:rgb(var(--ink));border-color:rgb(var(--rule))}.ds-btn-outline:hover{background:rgb(var(--sunk));border-color:rgb(var(--faint))}"
    },
    {
      "name": "Quiet Button",
      "kind": "button",
      "refersTo": "button-quiet",
      "description": "Section links like 'Full market' and icon toggles.",
      "html": "<button class=\"ds-btn ds-btn-quiet\">Full market <svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"currentColor\"><path fill-rule=\"evenodd\" d=\"M2 8a.75.75 0 0 1 .75-.75h8.69L8.22 4.03a.75.75 0 0 1 1.06-1.06l4.5 4.5a.75.75 0 0 1 0 1.06l-4.5 4.5a.75.75 0 0 1-1.06-1.06l3.22-3.22H2.75A.75.75 0 0 1 2 8Z\"/></svg></button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:36px;padding:0 14px;border-radius:8px;font-family:Archivo,ui-sans-serif,system-ui,sans-serif;font-size:14px;font-weight:600;border:1px solid transparent;cursor:pointer;transition:background-color .15s,color .15s,border-color .15s,transform .15s}.ds-btn:active{transform:scale(.98)}.ds-btn:focus-visible{outline:2px solid rgb(var(--serial));outline-offset:2px}.ds-btn-quiet{background:transparent;color:rgb(var(--muted))}.ds-btn-quiet:hover{background:rgb(var(--sunk));color:rgb(var(--ink))}"
    },
    {
      "name": "Period Segmented Control",
      "kind": "chip",
      "refersTo": "segment-active",
      "description": "Chart and market period picker; active segment is the note green.",
      "html": "<div class=\"ds-seg\" role=\"radiogroup\"><button class=\"ds-seg-b\">24H</button><button class=\"ds-seg-b ds-on\" aria-checked=\"true\">7D</button><button class=\"ds-seg-b\">30D</button><button class=\"ds-seg-b\">1Y</button></div>",
      "css": ".ds-seg{display:inline-flex;padding:2px;border:1px solid rgb(var(--rule));border-radius:8px;background:rgb(var(--panel))}.ds-seg-b{height:32px;min-width:44px;padding:0 10px;border:0;border-radius:6px;background:transparent;color:rgb(var(--muted));font-family:Archivo,sans-serif;font-variation-settings:'wdth' 85;font-weight:600;font-size:12px;letter-spacing:.08em;text-transform:uppercase;cursor:pointer;transition:background-color .15s,color .15s}.ds-seg-b:hover{background:rgb(var(--sunk));color:rgb(var(--ink))}.ds-seg-b.ds-on{background:rgb(var(--note));color:rgb(var(--note-ink))}.ds-seg-b:focus-visible{outline:2px solid rgb(var(--serial));outline-offset:2px}"
    },
    {
      "name": "Coin Chip",
      "kind": "chip",
      "refersTo": "chip-coin",
      "description": "Pill link to a coin with its icon.",
      "html": "<a class=\"ds-chip\" href=\"#\"><span class=\"ds-chip-i\">HY</span>Hyperliquid</a>",
      "css": ".ds-chip{display:inline-flex;align-items:center;gap:8px;padding:4px 12px 4px 4px;border:1px solid rgb(var(--rule));border-radius:9999px;background:rgb(var(--panel));color:rgb(var(--ink));font-family:Archivo,sans-serif;font-size:14px;font-weight:600;text-decoration:none;transition:background-color .15s,border-color .15s}.ds-chip:hover{background:rgb(var(--sunk));border-color:rgb(var(--faint))}.ds-chip:focus-visible{outline:2px solid rgb(var(--serial));outline-offset:2px}.ds-chip-i{display:grid;place-items:center;width:20px;height:20px;border-radius:50%;background:rgb(var(--mint));font-size:9px;font-weight:700}"
    },
    {
      "name": "Converter Field",
      "kind": "input",
      "refersTo": "input-field",
      "description": "Numeric input well with the unit set in serial type.",
      "html": "<label class=\"ds-field\"><input class=\"ds-input\" value=\"1\" inputmode=\"decimal\"><span class=\"ds-unit\">ETH</span></label>",
      "css": ".ds-field{position:relative;display:block;width:280px}.ds-input{width:100%;height:44px;padding:0 64px 0 12px;border:1px solid rgb(var(--rule));border-radius:8px;background:rgb(var(--paper));color:rgb(var(--ink));font-family:Archivo,sans-serif;font-size:16px;font-weight:600;font-variant-numeric:tabular-nums;outline:none;transition:border-color .15s}.ds-input:focus{border-color:rgb(var(--faint))}.ds-input:focus-visible{outline:2px solid rgb(var(--serial));outline-offset:2px}.ds-unit{position:absolute;right:12px;top:50%;transform:translateY(-50%);color:rgb(var(--muted));font-size:12px;font-weight:600;letter-spacing:.08em;font-variation-settings:'wdth' 85}"
    },
    {
      "name": "Main Navigation",
      "kind": "nav",
      "refersTo": "search-trigger",
      "description": "Header links with copper underline on the active page, plus the search trigger.",
      "html": "<nav class=\"ds-nav\"><a class=\"ds-nav-a ds-on\" href=\"#\">Overview</a><a class=\"ds-nav-a\" href=\"#\">Market</a><a class=\"ds-nav-a\" href=\"#\">Watchlist</a><a class=\"ds-nav-a\" href=\"#\">News</a><button class=\"ds-search\">Search coins…<kbd class=\"ds-kbd\">⌘K</kbd></button></nav>",
      "css": ".ds-nav{display:flex;align-items:center;gap:4px;height:60px;padding:0 16px;border-bottom:1px solid rgb(var(--rule));background:rgb(var(--paper));font-family:Archivo,sans-serif}.ds-nav-a{position:relative;padding:8px 12px;font-size:14px;font-weight:600;color:rgb(var(--muted));text-decoration:none;transition:color .15s}.ds-nav-a:hover{color:rgb(var(--ink))}.ds-nav-a.ds-on{color:rgb(var(--ink))}.ds-nav-a.ds-on::after{content:'';position:absolute;left:12px;right:12px;bottom:-13px;height:2px;background:rgb(var(--serial))}.ds-nav-a:focus-visible{outline:2px solid rgb(var(--serial));outline-offset:2px}.ds-search{margin-left:auto;display:flex;align-items:center;gap:8px;width:256px;height:36px;padding:0 8px 0 12px;border:1px solid rgb(var(--rule));border-radius:8px;background:rgb(var(--panel));color:rgb(var(--faint));font:inherit;font-size:14px;cursor:pointer}.ds-search:hover{border-color:rgb(var(--faint));color:rgb(var(--muted))}.ds-kbd{margin-left:auto;padding:2px 6px;border:1px solid rgb(var(--rule));border-radius:4px;background:rgb(var(--sunk));font-size:10px;font-weight:600;letter-spacing:.08em;color:rgb(var(--muted))}"
    },
    {
      "name": "Change Indicator",
      "kind": "custom",
      "description": "Price change with sign, arrow and direction colour.",
      "html": "<span class=\"ds-chg ds-up\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 20 20\" fill=\"currentColor\"><path fill-rule=\"evenodd\" d=\"M5.22 14.78a.75.75 0 0 0 1.06 0l7.22-7.22v5.69a.75.75 0 0 0 1.5 0v-7.5a.75.75 0 0 0-.75-.75h-7.5a.75.75 0 0 0 0 1.5h5.69l-7.22 7.22a.75.75 0 0 0 0 1.06Z\"/></svg>0.98%</span> <span class=\"ds-chg ds-down\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 20 20\" fill=\"currentColor\"><path fill-rule=\"evenodd\" d=\"M6.28 5.22a.75.75 0 0 0-1.06 1.06l7.22 7.22H6.75a.75.75 0 0 0 0 1.5h7.5a.75.75 0 0 0 .75-.75v-7.5a.75.75 0 0 0-1.5 0v5.69L6.28 5.22Z\"/></svg>0.03%</span>",
